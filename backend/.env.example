NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/hms_development?schema=public
TEST_DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/hms_test?schema=public
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Generate a unique high-entropy value; never commit the real secret.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=hms-api
JWT_AUDIENCE=hms-web
AUTH_COOKIE_NAME=hms_refresh
# AUTH_COOKIE_DOMAIN=
# Set true only behind a trusted single reverse proxy such as Render.
TRUST_PROXY=false

# Used only by the explicit `npm run bootstrap:admin -w backend` command.
# Remove these values from the environment immediately after bootstrap.
# HMS_BOOTSTRAP_ADMIN_USERNAME=admin
# HMS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
