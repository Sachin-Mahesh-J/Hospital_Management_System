NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/hms_development?schema=public
# Local Prisma migrations use the same database. Production must set DIRECT_URL to the
# Supabase direct or session-mode URI used only for `prisma migrate deploy`.
DIRECT_URL=postgresql://postgres:replace_me@localhost:5432/hms_development?schema=public
TEST_DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/hms_test?schema=public
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Generate a unique high-entropy value; never commit the real secret.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=hms-api
JWT_AUDIENCE=hms-web
AUTH_COOKIE_NAME=hms_refresh
# AUTH_COOKIE_DOMAIN=
# Set true only behind a trusted single reverse proxy such as Render.
TRUST_PROXY=false
# IANA time zone used for calendar-day expiry boundaries. Do not infer this from the server.
HOSPITAL_TIMEZONE=Asia/Colombo
# ISO 4217 currency used for every invoice and payment. Do not hardcode this in business logic.
DEFAULT_CURRENCY=LKR

# Private Supabase Storage for patient documents (ADR-004 / D-030). Never commit real keys.
# Use a dedicated non-production bucket locally. The service role key stays backend-only.
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key
SUPABASE_STORAGE_BUCKET=hms-patient-documents
DOCUMENT_SIGNED_URL_TTL_SECONDS=300
# Local-only. Production must use supabase. Tests always use memory regardless of this value.
DOCUMENT_STORAGE_DRIVER=memory

# Used only by the explicit `npm run bootstrap:admin -w backend` command.
# Remove these values from the environment immediately after bootstrap.
# HMS_BOOTSTRAP_ADMIN_USERNAME=admin
# HMS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
