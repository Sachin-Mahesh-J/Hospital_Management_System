# Copy the frontend and backend examples into their respective .env files.
# This root file is documentation only; the applications load their own .env files.
# Never commit real credentials. Production secrets belong only in Vercel, Render,
# and Supabase provider configuration.

# frontend/.env
VITE_API_URL=http://localhost:5000/api/v1

# backend/.env
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://hms_user:replace_me@localhost:5432/hms_development?schema=public
DIRECT_URL=postgresql://hms_user:replace_me@localhost:5432/hms_development?schema=public
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
DEFAULT_CURRENCY=LKR
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=replace-with-backend-only-supabase-secret-key
SUPABASE_STORAGE_BUCKET=hms-patient-documents
